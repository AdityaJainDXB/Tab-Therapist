{
    "manifest_version": 3,
    "name": "Tab Therapist",
    "version": "1.0.0",
    "description": "Your personal therapist for browser tabs",
    "permissions": [
        "tabs",
        "tabGroups",
        "storage"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icon.png",
            "32": "icon.png",
            "48": "icon.png",
            "128": "icon.png"
        }
    },
    "icons": {
        "16": "icon.png",
        "32": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
    }
}
